# ==============================================================================
# DentaCare Connect - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection String (PostgreSQL with Prisma ORM)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
DATABASE_URL="postgresql://postgres:password@localhost:5432/dentacare_db?schema=public"

# Granular PostgreSQL Connection Parameters (for Docker / local database provisioning)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=dentacare_db
DB_SCHEMA=public

# CORS Configuration (Frontend Client URL)
CLIENT_URL="http://localhost:3000"
